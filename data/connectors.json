{
  "meta": {
    "title": "Automotive connector, terminal and termination data",
    "revision": "2026-08-14",
    "pnPolicy": {
      "note": "Part numbers carry a confidence field. Nothing in this file is invented: where a manufacturer PN could not be stated with confidence it is null and the selection criteria (series, tang size, wire range, current rating) are given instead so the correct PN can be pulled from the supplier catalogue at BOM time. Always confirm against the current TE / Aptiv catalogue before releasing a build.",
      "confidenceLevels": {
        "high": "Long-standing published catalogue number, stable across revisions.",
        "medium": "Catalogue number believed correct but with known variants (plating, keying, seal option) — confirm the suffix.",
        "unspecified": "PN deliberately omitted; select from catalogue using the stated criteria."
      }
    },
    "deratingRule": {
      "note": "A connector's per-contact rating assumes only some contacts are loaded. When every contact in a housing carries current the contacts heat each other, and the derate grows with the number of ways. Interpolate on loaded-way count; the tabulated factors follow the shape of TE's published derating curves.",
      "byLoadedWays": [
        {
          "ways": 1,
          "factor": 1.0
        },
        {
          "ways": 2,
          "factor": 0.9
        },
        {
          "ways": 4,
          "factor": 0.8
        },
        {
          "ways": 8,
          "factor": 0.75
        },
        {
          "ways": 12,
          "factor": 0.7
        },
        {
          "ways": 24,
          "factor": 0.6
        }
      ],
      "ambientAbove85cFactor": 0.8
    }
  },
